# GitHub App credentials (Settings -> Developer settings -> GitHub Apps)
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string

# Public BirdScope site, used for deep links in replies
BIRDSCOPE_BASE_URL=https://YOURNAME.github.io/birdscope

# Default search when a command has no place
DEFAULT_LOCATION=Kolkata, West Bengal, India
DEFAULT_RADIUS_KM=25

# INFO, DEBUG, WARNING
LOG_LEVEL=INFO
