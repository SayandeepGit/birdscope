  "shortcuts": [
    {
      "name": "Explore Birds",
      "short_name": "Explore",
      "description": "Search for birds near a location",
      "url": "#/",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "purpose": "any" }]
    },
    {
      "name": "My Favorites",
      "short_name": "Favorites",
      "description": "View your saved birds",
      "url": "#/favorites",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "purpose": "any" }]
    },
    {
      "name": "Bird of the Day",
      "short_name": "BOTD",
      "description": "View today's featured bird",
      "url": "#/explore?botd=true",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "purpose": "any" }]
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing",
    "target_client": "auto"
  },
  "protocol_handlers": [
    {
      "protocol": "web+birdscope",
      "url": "#/explore?location=%s"
    }
  ],
  "share_target": {
    "action": "#/explore",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "name",
      "text": "q",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "#/explore",
      "accept": {
        "text/csv": [".csv"],
        "application/json": [".json"]
      }
    }
  ],
  "related_applications": [],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-17d8db7f28c7",
  "edge_side_panel": {
    "preferred_width": 400
  }
}